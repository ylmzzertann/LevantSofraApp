# Copy to .env.local and fill in. Everything here is optional — with none of it
# set the app runs on an embedded local Postgres with mock payments, which is
# how it works out of the box.

# --- Database -----------------------------------------------------------
# Supabase → Project settings → Database → Connection string → URI.
# Use the connection *pooler* URI (port 6543) for serverless deployments.
# Leave unset to use the embedded local database, which lives outside the
# project folder (%LOCALAPPDATA%\levant-sofra\pg on Windows, ~/.cache elsewhere)
# so a file-sync client can't corrupt a live Postgres cluster.
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Override where the local development database is kept.
# LOCAL_DB_DIR=

# --- Dish photos --------------------------------------------------------
# Without these, uploads go to public/uploads — fine locally, but Vercel's
# filesystem is read-only, so photos will disappear. Set these before deploying.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=            # server-only, never expose to the browser
# SUPABASE_BUCKET=dish-photos

# --- Secrets ------------------------------------------------------------
# Signs the table QR codes, so knowing a table number isn't enough to order to
# it. REQUIRED in production — without it table ordering is switched off. Any
# long random string, e.g. the output of:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it invalidates every printed sticker (which is also how you retire them).
# APP_SECRET=

# The address printed into the QR codes. Set it to the real site before printing.
# PUBLIC_BASE_URL=https://your-restaurant-domain.com

# --- Staff accounts -----------------------------------------------------
# Everyone signs in with their own email and password. In development an owner
# is created automatically (owner@levant.dev / levant-dev). In production nobody
# is: open /admin/setup once and create the owner account with this token.
# 16+ characters. You can remove it again once the owner exists.
# SETUP_TOKEN=

# --- Payments -----------------------------------------------------------
# Unset = mock provider, which approves every order without charging.
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
